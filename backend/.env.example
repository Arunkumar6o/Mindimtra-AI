# MindMitra Backend Environment Variables

PORT=5000
NODE_ENV=development

# Google Gemini API Key (Foundation AI Companion & Deep Unified Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret
JWT_SECRET=mindmitra-super-secret-key-2026

# AES-256-GCM Encryption Key (64 hex characters / 32 bytes)
# Example generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MINDMITRA_ENCRYPTION_KEY_256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Supabase Credentials (PostgreSQL with Row Level Security)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

