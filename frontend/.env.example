VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Google Gemini API Key (Foundation AI Companion & Deep Unified Analysis)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
